# GigaChat (developers.sber.ru) — ключ авторизации в Base64
GIGACHAT_CREDENTIALS=
# Область: GIGACHAT_API_PERS / GIGACHAT_API_B2B / GIGACHAT_API_CORP
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Основная модель (medium). При ошибке/лимите автоматически переключается на GigaChat (lite)
GIGACHAT_MODEL=GigaChat-Pro
# 0 — отключить проверку TLS (не нужно при наличии server/certs/russian_trusted_ca.pem)
GIGACHAT_TLS_VERIFY=1

# Telegram-бот для заявок (токен от @BotFather) и chat_id получателя
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
